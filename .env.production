# Supabase connection, committed on purpose.
#
# The publishable key is a public identifier, not a secret — it ships inside
# the JavaScript bundle of any static site, so anyone who loads the app can
# read it. Putting it in a repo secret would look safer while changing nothing,
# and would silently produce a build with no connection if it went missing.
#
# What actually protects the data is row-level security: every table is closed
# by default and opens only to members of the owning household.
VITE_SUPABASE_URL=https://ivjxtlznikqxyscyyxzk.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_AyiE1P_yJ8aaBtDCqgMS0Q_22dROzpT
