{
  "name": "larder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:receipt": "esbuild src/lib/receipt.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/receipt.test.mjs --log-level=error --define:import.meta.env='{}' && node node_modules/.tmp/receipt.test.mjs",
    "test:tripscan": "esbuild src/lib/tripScan.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/tripscan.test.mjs --log-level=error --define:import.meta.env='{}' && node node_modules/.tmp/tripscan.test.mjs",
    "test": "npm run test:receipt && npm run test:tripscan"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
